# Environment variables override config.yaml. Never commit real values.
APP_ADDR=:8080
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Asia/Shanghai
APP_LOG_LEVEL=info
APP_LOG_FORMAT=json
DATA_DIR=/data
CACHE_DIR=/cache
TEMP_DIR=/tmp/cyber-amber
DATABASE_PATH=/data/cyber-amber.db
DATABASE_BUSY_TIMEOUT=5s

# Exactly 32 random bytes, base64 encoded; prefer *_FILE with a Docker secret.
COOKIE_ENCRYPTION_KEY=
COOKIE_ENCRYPTION_KEY_FILE=/run/secrets/cookie_encryption_key
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_HASH_FILE=/run/secrets/admin_password_hash
SESSION_SECRET=
SESSION_SECRET_FILE=/run/secrets/session_secret

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_CONCURRENCY=2
WORKER_CONCURRENCY=2
BILI_PUBLISH_CONCURRENCY=1
JOB_TIMEOUT=10m
JOB_LEASE_DURATION=2m
JOB_MAX_ATTEMPTS=3
FONT_FAMILY=Noto Sans CJK SC
PUBLIC_WEB_ENABLED=true
PUBLIC_RATE_LIMIT=10
BILI_JOBS_PER_MID_DAY=20
USER_CONCURRENT_JOBS=2
VIDEO_JOBS_PER_HOUR=20
USER_COOLDOWN=30s
ARTIFACT_RETENTION=168h
ARTIFACT_QUOTA_BYTES=21474836480
DEFAULT_FPS=10
DEFAULT_WIDTH=640
DEFAULT_DANMAKU=false
DEFAULT_DANMAKU_OPACITY=0.85
DEFAULT_DANMAKU_FONT_SCALE=1.0
DEFAULT_DANMAKU_DENSITY=1.0
MAX_CLIP_DURATION=15s
ABSOLUTE_MAX_CLIP_DURATION=30s
MAX_OUTPUT_WIDTH=1280
MAX_OUTPUT_FPS=20
MAX_GIF_BYTES=8388608
MIN_FPS=5
MIN_WIDTH=320
MIN_COLORS=64
MIN_FREE_DISK_BYTES=1073741824
BILI_POLL_INTERVAL=20s
BILI_NOTIFICATION_ENABLED=true
BILI_BACKFILL_ON_FIRST_RUN=false
BILI_DRY_RUN=true
BILI_MAX_PUBLISH_PER_DAY=50
BILI_REPLY_ORIGINAL_COMMENT=true
TRUSTED_PROXY_CIDRS=
# Cookie may be imported only through a protected environment/secret.
BILI_COOKIE=
